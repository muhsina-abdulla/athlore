# Copy this file to .env and fill in both values. The .env file is gitignored.
# Find them in the Supabase dashboard: Project Settings > API.
#
# The anon (public) key is safe to ship in an app: Row Level Security protects the
# data. Never put the service-role key here.
#
# After creating or changing .env, restart the dev server with: npx expo start --clear
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
